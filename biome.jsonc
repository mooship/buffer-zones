{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useBlockStatements": "error" }
    }
  },
  "formatter": { "enabled": true, "indentStyle": "space" },
  "files": {
    "ignore": [
      "dist",
      "node_modules",
      "data-pipeline/output",
      "packages/web/public/data"
    ]
  }
}
