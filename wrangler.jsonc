{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buffer-zones",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "assets": {
    "directory": "./packages/web/dist"
  },
  "observability": {
    "enabled": true
  },
