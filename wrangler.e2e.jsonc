{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karta",
  "compatibility_date": "2026-07-27",
  "main": "./packages/web/workers/app.ts",
  "workers_dev": true,
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "./packages/web/build/client"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
